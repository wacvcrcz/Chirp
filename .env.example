# Supabase — publishable and secret keys replace the legacy anon/service_role keys.
# Legacy names (NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY) still work
# until Supabase retires them; check the current project settings before deploying.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=              # server only
DATABASE_URL=                     # pooled connection string (transaction mode)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=

# Local development with `npx supabase start` (values from `npx supabase status -o env`).
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable key>

# Database tests (skipped when unset). pnpm db:test-setup creates chirp_test.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/chirp_test
# TEST_SUPABASE_URL=http://127.0.0.1:54321
# TEST_SUPABASE_PUBLISHABLE_KEY=<publishable key>
