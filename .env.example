# Supabase — publishable and secret keys replace the legacy anon/service_role keys.
# Legacy names (NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY) still work
# until Supabase retires them; check the current project settings before deploying.
# Comments live on their own lines: a trailing comment is not part of the value.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never expose this key to the browser or the test runner's client.
SUPABASE_SECRET_KEY=

# Pooled connection string (transaction mode). Hosted projects require TLS.
DATABASE_URL=

# Optional. postgres.js pool size. Defaults: 1 in the app, 5 in scripts.
DB_POOL_SIZE=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=

# Database tests run against the hosted dev project through the admin API and
# create/delete their own users. They, db:seed and db:unseed refuse to run when
# the target project ref equals PRODUCTION_PROJECT_REF. When unset, they warn
# and proceed, so set this as soon as a production project exists.
PRODUCTION_PROJECT_REF=
